#!/bin/sh

case $BLOCK_BUTTON in
	1) setsid -f "$TERMINAL" -e stig ;;
	2) td-toggle ;;
	3) notify-send "🌱 Torrent module" "\- Left click to open stig.
- Middle click to toggle transmission.
- Shift click to edit script.
Module shows number of torrents:
🛑: paused
🕰: idle (seeds needed)
🔼: uploading (unfinished)
🔽: downloading
✅: done
🌱: done and seeding" ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

transmission-remote -l | {
	stopped=0 seeding=0 complete=0 idle=0 upload=0 download=0
	while read -r torrent; do case "$torrent" in
		*Stopped* ) stopped=$((stopped + 1)) ;;
		*Seeding* ) seeding=$((seeding + 1)) ;;
		*100%* ) complete=$((complete + 1)) ;;
		*Idle* ) idle=$((idle + 1)) ;;
		*Uploading* ) upload=$((upload + 1)) ;;
		*%* ) download=$((download + 1)) ;;
	esac done
	[ $stopped -gt 0 ] && torrents="$torrents 🛑$stopped"
	[ $idle -gt 0 ] && torrents="$torrents 🕰️$idle"
	[ $upload -gt 0 ] && torrents="$torrents ⬆️$upload"
	[ $download -gt 0 ] && torrents="$torrents ⬇️$download"
	[ $complete -gt 0 ] && torrents="$torrents ✅$complete"
	[ $seeding -gt 0 ] && torrents="$torrents 🌱$seeding"
	printf "%s\n" "${torrents# }"
}
